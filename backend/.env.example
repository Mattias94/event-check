PORT=3001
CORS_ORIGIN=http://localhost:3000

# Conexão com o PostgreSQL (Supabase) usada pela aplicação — pooler em modo transação (porta 6543)
# Atenção: caracteres especiais na senha precisam ser URL-encoded (@ -> %40, # -> %23, etc.)
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta usada pelas migrations (prisma.config.ts) — pooler em modo sessão (porta 5432)
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Resend (https://resend.com) — padrão quando EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Mailchimp Transactional / Mandrill — use EMAIL_PROVIDER=mandrill
# MANDRILL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# MAILCHIMP_TRANSACTIONAL_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Verificação de e-mail no cadastro (true = obrigatório | false = desabilitado)
EMAIL_VERIFICATION_REQUIRED=false

# Provedor de e-mail: resend | mandrill | mailchimp
EMAIL_PROVIDER=mandrill

# Mailchimp Transactional (Mandrill) — https://mailchimp.com/developer/transactional/
MANDRILL_API_KEY=sua_chave

# Remetente: use um domínio verificado no Mailchimp Transactional
MAIL_FROM=Event Check <noreply@seudominio.com>

# URL do frontend (links de verificação de e-mail e reset de senha)
FRONTEND_URL=http://localhost:3000

# Segredo usado para assinar o token (JWT) embutido no QR code de check-in
QR_TOKEN_SECRET=troque-por-um-segredo-forte

# Segredo usado para assinar o token de sessão (JWT) emitido no login
AUTH_TOKEN_SECRET=troque-por-outro-segredo-forte
