PORT=3001
CORS_ORIGIN=http://localhost:3000

# Conexão com o PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://postgres:senha@localhost:5432/event-check?schema=public"

# Resend (https://resend.com) — chave da API para envio de e-mails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente dos e-mails (domínio verificado no Resend; em testes use onboarding@resend.dev)
MAIL_FROM=Event Check <onboarding@resend.dev>

# Segredo usado para assinar o token (JWT) embutido no QR code de check-in
QR_TOKEN_SECRET=troque-por-um-segredo-forte

# Segredo usado para assinar o token de sessão (JWT) emitido no login
AUTH_TOKEN_SECRET=troque-por-outro-segredo-forte
